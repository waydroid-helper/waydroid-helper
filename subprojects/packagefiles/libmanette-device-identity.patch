+const char *
+manette_evdev_backend_get_instance_identifier (ManetteEvdevBackend *self)
+{
+  const char *serial = libevdev_get_uniq (self->evdev_device);
+
+  /* The physical port is stable across event-node renumbering for USB pads
+   * without a serial. Both values belong to the already-open input device. */
+  return serial && *serial ? serial : libevdev_get_phys (self->evdev_device);
+}
