 /**
+ * manette_device_get_instance_identifier:
+ * @self: a device
+ *
+ * Returns: (transfer none) (nullable): serial number or physical port, when available
+ */
+const char *
+manette_device_get_instance_identifier (ManetteDevice *self)
+{
+  g_return_val_if_fail (MANETTE_IS_DEVICE (self), NULL);
+
+  if (MANETTE_IS_EVDEV_BACKEND (self->backend))
+    return manette_evdev_backend_get_instance_identifier (MANETTE_EVDEV_BACKEND (self->backend));
+
+  return NULL;
+}
